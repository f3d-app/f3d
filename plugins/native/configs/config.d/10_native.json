[
  {
    "match-type": "glob",
    "match": "*.{dcm,nrrd,nhdr,mhd,mha,vtp,vtu,vtr,vti,vts,vtm}",
    "options": {
      "coloring-mode": "scivis",
      "coloring-scalar-bar": true
    }
  },
  {
    "match-type": "glob",
    "match": "*.{dcm,nrrd,nhdr,mhd,mha,vti}",
    "options": {
      "volume": true
    }
  },
  {
    "match-type": "glob",
    "match": "*.{3ds,stl}",
    "options": {
      "up": "+Z",
      "camera-direction": "-1,1,-0.5"
    }
  },
  {
    "match-type": "glob",
    "match": "*.{stl,gml,pts}",
    "options": {
      "coloring-mode": "scivis"
    }
  },
  {
    "match-type": "glob",
    "match": "*.{tif,tiff}",
    "options": {
      "coloring-mode": "direct",
      "up": "-Y",
      "camera-direction": "-1,0.5,1"
    }
  },
  {
    "match-type": "glob",
    "match": "*.{png,jpg,jpeg,bmp,tga,hdr,webp,exr}",
    "options": {
      "camera-direction": "0,0,-1",
      "camera-orthographic": true,
      "interaction-style": "2d",
      "axis": false
    }
  },
  {
    "match-type": "glob",
    "match": "*.ply",
    "options": {
      "coloring-mode": "direct",
      "blending": "ddp"
    }
  },
  {
    "match-type": "glob",
    "match": "*.{splat,spz}",
    "options": {
      "point-sprites": "gaussian",
      "point-sprites-absolute-size": true,
      "point-sprites-size": 1,
      "coloring-mode": "direct",
      "coloring-array": "color",
      "background-color": "0, 0, 0",
      "interaction-style": "trackball",
      "tone-mapping": false,
      "grid": false,
      "anti-aliasing": "none",
      "blending": "sort"
    }
  },
  {
    "match-type": "glob",
    "match": "*.splat",
    "options": {
      "up": "-Y",
      "camera-position": "0,1,-5.2",
      "camera-focal-point": "0,1,0"
    }
  },
  {
    "match-type": "glob",
    "match": "*.spz",
    "options": {
      "camera-position": "0,1,4",
      "camera-focal-point": "0,0,0"
    }
  },
  {
    "match-type": "glob",
    "match": "*.mdl",
    "options": {
      "up": "+Z"
    }
  }
]
