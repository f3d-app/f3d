[
  {
    "match-type": "glob",
    "match": "*.{step,stp,iges,igs,brep,xbf,fcstd,FCStd}",
    "options": {
      "coloring-mode": "direct",
      "load-plugins": "occt",
      "up": "+Z",
      "ambient-occlusion": true,
      "coloring-by-cells": true,
      "camera-direction": "-1,1,-0.5"
    }
  }
]
